         public boolean httpOnly = false;
+        /**
+         * SameSite attribute used for the cookies that don't specify one. Can be configured using the property
+         * 'application.session.sameSite' in application.conf (Lax, Strict or None). When null the attribute is not
+         * sent.
+         */
+        public static String defaultSameSite = null;
+        /**
+         * SameSite attribute of this cookie (Lax, Strict or None). When null {@link #defaultSameSite} is used.
+         */
+        public String sameSite;
+
+        /**
+         * Normalize the value of a SameSite attribute.
+         *
+         * @param value
+         *            the configured value, case insensitive
+         * @return Lax, Strict or None; null if the value is null or empty
+         * @throws IllegalArgumentException
+         *             if the value is not a valid SameSite attribute
+         */
+        public static String parseSameSite(String value) {
+            if (value == null || value.trim().isEmpty()) {
+                return null;
+            }
+            for (String valid : new String[] { "Lax", "Strict", "None" }) {
+                if (valid.equalsIgnoreCase(value.trim())) {
+                    return valid;
+                }
+            }
+            throw new IllegalArgumentException("Invalid SameSite value '" + value + "': use Lax, Strict or None");
+        }
     }
 
